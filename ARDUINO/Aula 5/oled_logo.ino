void setup() {
  // Inicializa a comunicação I2C com o OLED no endereço 0x3C
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    for (;;); // Trava o programa se o OLED não for detectado
  }

  // Limpa o buffer do display
  display.clearDisplay();

  // Desenha a imagem (Logo do SENAI) no centro vertical da tela
  // Posição X = 0, Posição Y = (64 - 34) / 2 = 15
  int y_pos = (SCREEN_HEIGHT - LOGO_HEIGHT) / 2;
  
  display.drawBitmap(0, y_pos, logo_senai_bmp, LOGO_WIDTH, LOGO_HEIGHT, SSD1306_WHITE);

  // Atualiza a tela para exibir o desenho
  display.display();
}

void loop() {
  // Nada necessário no loop
}
